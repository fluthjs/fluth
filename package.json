{
  "name": "fluth",
  "version": "0.3.34",
  "description": "A Promise-like Reactive Stream Library",
  "author": "yiludege <https://github.com/yiludege>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluthjs/fluth.git"
  },
  "homepage": "https://fluthjs.github.io/fluth-doc/index.html",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "fluth",
    "promise",
    "stream"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "dev": "tsup --watch",
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint": "eslint --cache --fix",
    "lint:check": "eslint",
    "check:pkg": "publint --strict && attw --pack .",
    "test:smoke": "node -e 'import(\"fluth\").then(({ $, Stream }) => { const s = $({ n: 1 }); let out; s.then(v => { out = v.n }); s.set(d => { d.n = 42 }); if (!(s instanceof Stream) || out !== 42) process.exit(1); console.log(\"ESM OK:\", out); })' && node -e 'const { $, Stream } = require(\"fluth\"); const s = $({ n: 1 }); let out; s.then(v => { out = v.n }); s.set(d => { d.n = 42 }); if (!(s instanceof Stream) || out !== 42) process.exit(1); console.log(\"CJS OK:\", out);'",
    "coverage": "vitest run --coverage",
    "release": "standard-version",
    "release-major": "standard-version --release-as major",
    "release-minor": "standard-version --release-as minor",
    "release-patch": "standard-version --release-as patch"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.9.0",
    "@types/eslint__js": "^8.42.3",
    "@vitest/coverage-v8": "2.0.5",
    "eslint": "^9.9.0",
    "husky": "^9.1.5",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "publint": "^0.3.25",
    "standard-version": "^9.5.0",
    "tsup": "^9.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "2.0.5"
  },
  "dependencies": {
    "limu": "^3.13.1"
  }
}
